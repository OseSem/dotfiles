{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__sentry__*",
      "Bash(cd:*)",
      "Bash(cd * && git status)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git clone:*)",
      "Bash(gh repo:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(gh auth status)",
      "Bash(gh run:*)",
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv init:*)",
      "Bash(uv build:*)",
      "Bash(uv publish:*)",
      "Bash(uv pip:*)",
      "Bash(uv python:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(go build:*)",
      "Bash(go run:*)",
      "Bash(go test:*)",
      "Bash(go mod:*)",
      "Bash(go get:*)",
      "Bash(go install:*)",
      "Bash(go fmt:*)",
      "Bash(go vet:*)",
      "Bash(go generate:*)",
      "Bash(go clean:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|agent_completed|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/ruff.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sem/Library/Application Support/StillOn/AgentBridge/StillOn",
            "args": [
              "--provider",
              "claude"
            ],
            "timeout": 2
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
